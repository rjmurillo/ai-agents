{
  "path": [
    "."
  ],
  "format": [
    "python"
  ],
  "minTokens": 100,
  "minLines": 10,
  "gitignore": true,
  "reporters": [
    "console"
  ],
  "ignore": [
    "**/node_modules/**",
    "**/.venv/**",
    "**/__pycache__/**",
    "src/copilot-cli/**",
    "src/codex/**",
    "src/hermes/**",
    "src/muse/**",
    "src/cursor/**",
    "src/claude/lib/**",
    "src/claude/hooks/**",
    "src/claude/skills/review/scripts/**",
    "src/claude/skills/spec/scripts/metrics_writer.py",
    ".claude/lib/ai_review_common/**",
    ".claude/lib/github_core/**",
    ".claude/lib/hook_utilities/**",
    ".claude/lib/failure_classifier/**",
    ".claude/lib/bootstrap.py",
    ".claude/lib/paths.py",
    ".claude/hooks/**"
  ]
}
