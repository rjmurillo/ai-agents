{
  "description": "Claude Code hook-group manifest consumed by invoke_dispatch_claude.py (one process per (event, matcher) group) and expanded by build/scripts/generate_hooks_events.py back to per-hook entries so the generated Copilot tree is unchanged. file is relative to .claude/hooks/. timeout/statusMessage preserve the pre-consolidation per-hook registration values for generator fidelity. copilotMatcher overrides the group matcher for Copilot shim generation only.",
  "groups": {
    "sessionstart-1-session_initialization_enforcer": {
      "event": "SessionStart",
      "mode": "observe",
      "matcher": null,
      "shims": [
        {
          "file": "SessionStart/invoke_context_loader.py",
          "statusMessage": "Auto-loading HANDOFF.md and latest retrospective (#1703)"
        }
      ]
    },
    "stop-1-skill_learning": {
      "event": "Stop",
      "mode": "gate_all",
      "matcher": null,
      "shims": [
        {
          "file": "Stop/invoke_auto_retrospective.py",
          "statusMessage": "Auto-generating session retrospective (#1703)"
        }
      ]
    },
    "plugin-pretooluse-8-retrospective_gate": {
      "event": "PreToolUse",
      "mode": "gate",
      "matcher": "Bash(git push*)",
      "surface": "plugin",
      "shims": [
        {
          "file": "PreToolUse/invoke_markdownlint_guard.py",
          "timeout": 90,
          "statusMessage": "Checking markdownlint violations on changed .md files (BLOCKING)"
        }
      ]
    },
    "plugin-posttooluse-1-markdown_auto_lint": {
      "event": "PostToolUse",
      "mode": "observe",
      "matcher": "^(Write|Edit)$",
      "surface": "plugin",
      "shims": [
        {
          "file": "PostToolUse/invoke_markdown_auto_lint.py",
          "statusMessage": "Auto-linting markdown files"
        }
      ]
    },
    "plugin-posttooluse-observation_sync": {
      "event": "PostToolUse",
      "mode": "observe",
      "matcher": "mcp__serena__write_memory",
      "surface": "plugin",
      "shims": [
        {
          "file": "PostToolUse/invoke_observation_sync.py",
          "timeout": 30,
          "statusMessage": "Syncing observation memories to Forgetful"
        }
      ]
    },
    "plugin-permissionrequest-test_auto_approval": {
      "event": "PermissionRequest",
      "mode": "gate",
      "matcher": "Bash(pwsh*Invoke-Pester*|npm test*|npm run test*|pnpm test*|yarn test*|pytest*|python*pytest*|dotnet test*|mvn test*|gradle test*|go test*)",
      "surface": "plugin",
      "shims": [
        {
          "file": "PermissionRequest/invoke_test_auto_approval.py",
          "statusMessage": "Auto-approving test execution"
        }
      ]
    }
  }
}
