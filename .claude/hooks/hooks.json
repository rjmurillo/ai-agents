{
  "description": "Plugin hooks for project-toolkit. Every registration routes through invoke_dispatch_claude.py (one process per (event, matcher) group, issue #3075); membership lives in dispatch_groups.json (plugin-* groups). Inside a checkout of the repo that publishes this plugin, the dispatcher exits immediately so hooks do not double-fire with .claude/settings.json.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash(git push*)",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -u \"${CLAUDE_PLUGIN_ROOT}/hooks/invoke_dispatch_claude.py\" --group plugin-pretooluse-8-retrospective_gate",
            "timeout": 300,
            "statusMessage": "Running plugin-pretooluse-8-retrospective_gate hooks (grouped, #3075)"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(Write|Edit)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -u \"${CLAUDE_PLUGIN_ROOT}/hooks/invoke_dispatch_claude.py\" --group plugin-posttooluse-1-markdown_auto_lint",
            "timeout": 60,
            "statusMessage": "Running plugin-posttooluse-1-markdown_auto_lint hooks (grouped, #3075)"
          }
        ]
      },
      {
        "matcher": "mcp__serena__write_memory",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -u \"${CLAUDE_PLUGIN_ROOT}/hooks/invoke_dispatch_claude.py\" --group plugin-posttooluse-observation_sync",
            "timeout": 60,
            "statusMessage": "Running plugin-posttooluse-observation_sync hooks (grouped, #3075)"
          }
        ]
      }
    ]
  }
}
