{
  "description": "Plugin hooks for project-toolkit. Each (event, matcher) group registers ONE dispatch_claude.py process that runs the group's existing hook bodies in-process (issue #3075); group membership is unchanged from the previous per-hook registrations and lives in dispatch_groups.json (plugin-* groups). Inside a checkout of the repo that publishes this plugin, the dispatcher exits immediately so hooks do not double-fire with .claude/settings.json.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -u \"${CLAUDE_PLUGIN_ROOT}/hooks/dispatch_claude.py\" --group plugin-pretooluse-bash",
            "timeout": 60,
            "statusMessage": "Running Bash pre-tool gates (grouped, #3075)"
          }
        ]
      },
      {
        "matcher": "Bash(git commit*)",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -u \"${CLAUDE_PLUGIN_ROOT}/hooks/dispatch_claude.py\" --group plugin-git-commit",
            "timeout": 120,
            "statusMessage": "Running commit gates (grouped, #3075)"
          }
        ]
      },
      {
        "matcher": "Bash(gh pr create*)",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -u \"${CLAUDE_PLUGIN_ROOT}/hooks/dispatch_claude.py\" --group plugin-gh-pr-create",
            "statusMessage": "Verifying session log exists before PR creation (BLOCKING)"
          }
        ]
      },
      {
        "matcher": "^(Write|Edit)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -u \"${CLAUDE_PLUGIN_ROOT}/hooks/dispatch_claude.py\" --group plugin-write-edit-pre",
            "timeout": 60,
            "statusMessage": "Running Write/Edit pre-tool gates (grouped, #3075)"
          }
        ]
      },
      {
        "matcher": "Bash(git push*)",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -u \"${CLAUDE_PLUGIN_ROOT}/hooks/dispatch_claude.py\" --group plugin-git-push",
            "timeout": 300,
            "statusMessage": "Running push gates (grouped, #3075)"
          }
        ]
      },
      {
        "matcher": "Grep",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -u \"${CLAUDE_PLUGIN_ROOT}/hooks/dispatch_claude.py\" --group plugin-lsp-grep",
            "timeout": 5,
            "statusMessage": "Enforcing LSP-first over Grep on code symbols (ADR-062, conditional)"
          }
        ]
      },
      {
        "matcher": "Glob",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -u \"${CLAUDE_PLUGIN_ROOT}/hooks/dispatch_claude.py\" --group plugin-lsp-glob",
            "timeout": 5,
            "statusMessage": "Enforcing LSP-first over symbol-shaped Glob (ADR-062, conditional)"
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -u \"${CLAUDE_PLUGIN_ROOT}/hooks/dispatch_claude.py\" --group plugin-lsp-read",
            "timeout": 5,
            "statusMessage": "Enforcing LSP-first navigation before code Read (ADR-062, graduated)"
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -u \"${CLAUDE_PLUGIN_ROOT}/hooks/dispatch_claude.py\" --group plugin-lsp-agent",
            "timeout": 5,
            "statusMessage": "Requiring pre-resolved LSP context for delegated implementation agents (ADR-062)"
          }
        ]
      },
      {
        "matcher": "Task",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -u \"${CLAUDE_PLUGIN_ROOT}/hooks/dispatch_claude.py\" --group plugin-lsp-task",
            "timeout": 5,
            "statusMessage": "Requiring pre-resolved LSP context for delegated implementation agents (ADR-062)"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -u \"${CLAUDE_PLUGIN_ROOT}/hooks/dispatch_claude.py\" --group plugin-sessionstart",
            "timeout": 120,
            "statusMessage": "Running session-start hooks (grouped, #3075)"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -u \"${CLAUDE_PLUGIN_ROOT}/hooks/dispatch_claude.py\" --group plugin-userpromptsubmit",
            "timeout": 30,
            "statusMessage": "Running prompt-submit hooks (grouped, #3075)"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(Write|Edit)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -u \"${CLAUDE_PLUGIN_ROOT}/hooks/dispatch_claude.py\" --group plugin-posttooluse-write-edit",
            "timeout": 120,
            "statusMessage": "Running Write/Edit post-tool hooks (grouped, #3075)"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -u \"${CLAUDE_PLUGIN_ROOT}/hooks/dispatch_claude.py\" --group plugin-posttooluse-bash",
            "statusMessage": "Checking for ADR changes"
          }
        ]
      },
      {
        "matcher": "mcp__serena__write_memory",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -u \"${CLAUDE_PLUGIN_ROOT}/hooks/dispatch_claude.py\" --group plugin-observation-sync",
            "timeout": 30,
            "statusMessage": "Syncing observation memories to Forgetful"
          }
        ]
      },
      {
        "matcher": "^(mcp__serena__(find_symbol|find_referencing_symbols|get_symbols_overview|find_implementations|get_diagnostics_for_file)|mcp__plugin_[^_]*serena[^_]*__(find_symbol|find_referencing_symbols|get_symbols_overview|find_implementations|get_diagnostics_for_file)|LSP)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -u \"${CLAUDE_PLUGIN_ROOT}/hooks/dispatch_claude.py\" --group plugin-lsp-usage-tracker",
            "timeout": 5,
            "statusMessage": "Tracking LSP navigation calls for the LSP-first gate (ADR-062)"
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -u \"${CLAUDE_PLUGIN_ROOT}/hooks/dispatch_claude.py\" --group plugin-lsp-read-tracker",
            "timeout": 5,
            "statusMessage": "Tracking Read operations for the LSP-first gate (ADR-062)"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -u \"${CLAUDE_PLUGIN_ROOT}/hooks/dispatch_claude.py\" --group plugin-stop",
            "timeout": 300,
            "statusMessage": "Running stop hooks (grouped, #3075)"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -u \"${CLAUDE_PLUGIN_ROOT}/hooks/dispatch_claude.py\" --group plugin-subagentstop",
            "statusMessage": "Validating QA agent output"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "Bash(pwsh*Invoke-Pester*|npm test*|npm run test*|pnpm test*|yarn test*|pytest*|python*pytest*|dotnet test*|mvn test*|gradle test*|go test*)",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -u \"${CLAUDE_PLUGIN_ROOT}/hooks/dispatch_claude.py\" --group plugin-permissionrequest",
            "statusMessage": "Auto-approving test execution"
          }
        ]
      }
    ]
  }
}
