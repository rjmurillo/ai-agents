{
  "env": {
    "AI_AGENTS_PROJECT_REPO": "1"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "./.claude/hooks/session-start.sh",
            "timeout": 900,
            "statusMessage": "Installing project dependencies (matches CI)"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -u .claude/hooks/invoke_dispatch_claude.py --group sessionstart-1-context_loader",
            "timeout": 125,
            "statusMessage": "Running sessionstart-1-context_loader hooks (grouped, #3075)"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__serena__write_memory",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -u .claude/hooks/PostToolUse/invoke_observation_sync.py",
            "timeout": 30,
            "statusMessage": "Syncing observation memories to Forgetful"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -u .claude/hooks/PreCompact/invoke_compact_checkpoint.py",
            "statusMessage": "Checkpointing state before compaction (#1703)"
          }
        ]
      }
    ]
  }
}
