{
    "env": {
        "AI_AGENTS_PROJECT_REPO": "1"
    },
    "hooks": {
        "SessionStart": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "cd \"${CLAUDE_PROJECT_DIR:-$(git rev-parse --show-toplevel)}\" && ./.claude/hooks/session-start.sh",
                        "timeout": 900,
                        "statusMessage": "Installing project dependencies (matches CI)"
                    }
                ]
            },
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "cd \"${CLAUDE_PROJECT_DIR:-$(git rev-parse --show-toplevel)}\" && python3 -u .claude/hooks/invoke_dispatch_claude.py --group sessionstart-1-context_loader",
                        "timeout": 125,
                        "statusMessage": "Running sessionstart-1-context_loader hooks (grouped, #3075)"
                    }
                ]
            },
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "cd \"${CLAUDE_PROJECT_DIR:-$(git rev-parse --show-toplevel)}\" && python3 -u .claude/hooks/invoke_dispatch_claude.py --group sessionstart-2-checkout_freshness",
                        "timeout": 45,
                        "statusMessage": "Running sessionstart-2-checkout_freshness hooks (grouped, #4689)"
                    }
                ]
            }
        ],
        "UserPromptSubmit": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "cd \"${CLAUDE_PROJECT_DIR:-$(git rev-parse --show-toplevel)}\" && python3 -u .claude/hooks/UserPromptSubmit/invoke_memory_recall.py",
                        "timeout": 10,
                        "statusMessage": "Recalling relevant memories (#4011)"
                    }
                ]
            }
        ],
        "SessionEnd": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "cd \"${CLAUDE_PROJECT_DIR:-$(git rev-parse --show-toplevel)}\" && python3 -u .claude/hooks/SessionEnd/invoke_memory_reflection.py",
                        "timeout": 60,
                        "statusMessage": "Persisting memory confidence scores (#4011)"
                    }
                ]
            }
        ],
        "PreCompact": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "cd \"${CLAUDE_PROJECT_DIR:-$(git rev-parse --show-toplevel)}\" && python3 -u .claude/hooks/PreCompact/invoke_compact_checkpoint.py",
                        "statusMessage": "Checkpointing state before compaction (#1703)"
                    }
                ]
            }
        ]
    }
}
