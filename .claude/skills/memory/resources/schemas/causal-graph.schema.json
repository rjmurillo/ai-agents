{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "causal-graph.schema.json",
  "title": "Causal Graph Schema",
  "description": "Schema for the causal reasoning graph written by .claude/skills/memory/scripts/update_causal_graph.py. That writer is authoritative for this file; ADR-038's sequential-id contract described a writer that no longer runs (#3356).",
  "type": "object",
  "required": [
    "version",
    "updated",
    "nodes",
    "edges",
    "patterns"
  ],
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+$",
      "description": "Schema version"
    },
    "updated": {
      "type": "string",
      "format": "date-time",
      "description": "Last update timestamp"
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "label"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9a-f]{12}$",
            "description": "sha256('<type>:<label>')[:12]. Content derived rather than sequential because this file is merged by a union-aware driver: two branches that each allocate the next number both produce the same id for different content, and no merge can tell them apart."
          },
          "type": {
            "type": "string",
            "enum": [
              "artifact",
              "commit",
              "decision",
              "error",
              "milestone",
              "outcome",
              "test"
            ],
            "description": "Mirrors NODE_TYPES in .claude/skills/memory/scripts/update_causal_graph.py. A test asserts the two are equal, so widening one alone fails the build."
          },
          "label": {
            "type": "string"
          },
          "episodes": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Episode IDs where this node appears"
          },
          "frequency": {
            "type": "integer",
            "minimum": 0,
            "description": "Number of occurrences"
          },
          "success_rate": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "Success rate when this node is involved"
          },
          "created": {
            "type": "string",
            "format": "date-time",
            "description": "When this node first entered the graph."
          },
          "contributions": {
            "type": "object",
            "description": "Per-episode evidence, keyed by episode id."
          }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source",
          "target",
          "type"
        ],
        "properties": {
          "source": {
            "type": "string",
            "pattern": "^[0-9a-f]{12}$",
            "description": "Source node id. Same derivation as node.id."
          },
          "target": {
            "type": "string",
            "pattern": "^[0-9a-f]{12}$",
            "description": "Target node id. Same derivation as node.id."
          },
          "type": {
            "type": "string",
            "enum": [
              "causes",
              "enables",
              "prevents",
              "correlates"
            ],
            "description": "Relationship type"
          },
          "weight": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "Confidence weight"
          },
          "evidence_count": {
            "type": "integer",
            "minimum": 1,
            "description": "Number of episodes supporting this edge"
          },
          "created": {
            "type": "string",
            "format": "date-time",
            "description": "When this edge first entered the graph."
          },
          "episodes": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Episode IDs supporting this edge."
          },
          "contributions": {
            "type": "object",
            "description": "Per-episode evidence, keyed by episode id."
          }
        }
      }
    },
    "patterns": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "trigger",
          "action"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9a-f]{12}$",
            "description": "sha256('pattern:<name>')[:12]. Content derived, as for nodes."
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "trigger": {
            "type": "string",
            "description": "Condition that triggers this pattern"
          },
          "action": {
            "type": "string",
            "description": "Recommended action when triggered"
          },
          "success_rate": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "occurrences": {
            "type": "integer",
            "minimum": 1
          },
          "last_used": {
            "type": "string",
            "format": "date-time"
          },
          "episodes": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Episode IDs where this pattern appears."
          },
          "created": {
            "type": "string",
            "format": "date-time",
            "description": "When this pattern first entered the graph."
          },
          "contributions": {
            "type": "object",
            "description": "Per-episode evidence, keyed by episode id."
          }
        }
      }
    }
  }
}
