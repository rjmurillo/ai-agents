{
  "hooks": {
    "PostToolUse": [
      {
        "bash": "python3 -u \"${COPILOT_PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT}}/hooks/PostToolUse/_dispatch.py\"",
        "cwd": ".",
        "matcher": "Write|Edit",
        "powershell": "py -3 -u \"$(if ($env:COPILOT_PLUGIN_ROOT) {$env:COPILOT_PLUGIN_ROOT} else {$env:CLAUDE_PLUGIN_ROOT})/hooks/PostToolUse/_dispatch.py\"",
        "timeoutSec": 35,
        "type": "command"
      }
    ],
    "PreToolUse": [
      {
        "bash": "python3 -u \"${COPILOT_PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT}}/hooks/PreToolUse/_dispatch.py\"",
        "cwd": ".",
        "matcher": "Bash",
        "powershell": "py -3 -u \"$(if ($env:COPILOT_PLUGIN_ROOT) {$env:COPILOT_PLUGIN_ROOT} else {$env:CLAUDE_PLUGIN_ROOT})/hooks/PreToolUse/_dispatch.py\"",
        "timeoutSec": 95,
        "type": "command"
      }
    ]
  },
  "version": 1
}
