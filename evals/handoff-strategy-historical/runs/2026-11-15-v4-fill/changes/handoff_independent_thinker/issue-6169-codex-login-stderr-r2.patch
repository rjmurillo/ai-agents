@@ -18,3 +18,23 @@ def fake_run(argv: list[str], **kwargs: Any) -> Any:
 
     monkeypatch.setattr(src.subprocess, "run", fake_run)
     assert src.codex_login_probe("codex", {})
+
+
+def _run_returning(rc: int, out: str, err: str, monkeypatch: pytest.MonkeyPatch) -> bool:
+    def fake_run(argv: list[str], **kwargs: Any) -> Any:
+        return subprocess.CompletedProcess(argv, rc, out, err)
+
+    monkeypatch.setattr(src.subprocess, "run", fake_run)
+    return src.codex_login_probe("codex", {})
+
+
+def test_stderr_status_with_noise_lines(monkeypatch: pytest.MonkeyPatch) -> None:
+    assert _run_returning(0, "warn\n", "x\nLogged in using ChatGPT\ny\n", monkeypatch)
+
+
+def test_api_key_status_on_stderr_is_false(monkeypatch: pytest.MonkeyPatch) -> None:
+    assert not _run_returning(0, "", "Logged in using an API key\n", monkeypatch)
+
+
+def test_nonzero_rc_with_stderr_status_is_false(monkeypatch: pytest.MonkeyPatch) -> None:
+    assert not _run_returning(1, "", "Logged in using ChatGPT\n", monkeypatch)
