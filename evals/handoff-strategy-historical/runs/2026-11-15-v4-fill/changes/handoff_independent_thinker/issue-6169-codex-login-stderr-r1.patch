diff --git a/tests/eval/test_issue_6169_repro.py b/tests/eval/test_issue_6169_repro.py
index 8f40245..4aab324 100644
--- a/tests/eval/test_issue_6169_repro.py
+++ b/tests/eval/test_issue_6169_repro.py
@@ -18,3 +18,29 @@ def fake_run(argv: list[str], **kwargs: Any) -> Any:
 
     monkeypatch.setattr(src.subprocess, "run", fake_run)
     assert src.codex_login_probe("codex", {})
+
+
+def _run_with(monkeypatch: pytest.MonkeyPatch, stdout: str, stderr: str) -> bool:
+    def fake_run(argv: list[str], **kwargs: Any) -> Any:
+        return subprocess.CompletedProcess(argv, 0, stdout, stderr)
+
+    monkeypatch.setattr(src.subprocess, "run", fake_run)
+    return src.codex_login_probe("codex", {})
+
+
+def test_codex_login_probe_rejects_api_key_status_on_stderr(
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    assert not _run_with(monkeypatch, "", "Logged in using an API key\n")
+
+
+def test_codex_login_probe_accepts_status_after_a_stderr_warning(
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    assert _run_with(monkeypatch, "", "warning: something\nLogged in using ChatGPT\n")
+
+
+def test_codex_login_probe_does_not_glue_streams_together(
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    assert _run_with(monkeypatch, "banner", "Logged in using ChatGPT\n")
