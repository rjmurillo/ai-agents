diff --git a/tests/eval/test_issue_6169_repro.py b/tests/eval/test_issue_6169_repro.py
index 8f40245..e025396 100644
--- a/tests/eval/test_issue_6169_repro.py
+++ b/tests/eval/test_issue_6169_repro.py
@@ -18,3 +18,39 @@ def fake_run(argv: list[str], **kwargs: Any) -> Any:
 
     monkeypatch.setattr(src.subprocess, "run", fake_run)
     assert src.codex_login_probe("codex", {})
+
+
+def _run_with(monkeypatch: pytest.MonkeyPatch, rc: int, out: str, err: str) -> None:
+    def fake_run(argv: list[str], **kwargs: Any) -> Any:
+        return subprocess.CompletedProcess(argv, rc, out, err)
+
+    monkeypatch.setattr(src.subprocess, "run", fake_run)
+
+
+def test_codex_login_probe_reads_stdout(monkeypatch: pytest.MonkeyPatch) -> None:
+    _run_with(monkeypatch, 0, "Logged in using ChatGPT\n", "")
+    assert src.codex_login_probe("codex", {})
+
+
+def test_codex_login_probe_tolerates_extra_stderr_lines(
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    _run_with(monkeypatch, 0, "", "note: something\nLogged in using ChatGPT\n")
+    assert src.codex_login_probe("codex", {})
+
+
+def test_codex_login_probe_rejects_nonzero_rc(monkeypatch: pytest.MonkeyPatch) -> None:
+    _run_with(monkeypatch, 1, "", "Logged in using ChatGPT\n")
+    assert not src.codex_login_probe("codex", {})
+
+
+def test_codex_login_probe_rejects_other_status(monkeypatch: pytest.MonkeyPatch) -> None:
+    _run_with(monkeypatch, 0, "", "Not logged in\n")
+    assert not src.codex_login_probe("codex", {})
+
+
+def test_claude_login_probe_ignores_stderr(monkeypatch: pytest.MonkeyPatch) -> None:
+    _run_with(
+        monkeypatch, 0, '{"loggedIn": true, "authMethod": "claude.ai"}', "warning: noise\n"
+    )
+    assert src.claude_login_probe("claude", {})
