index 0000000..582de44
--- /dev/null
+++ b/tests/validation/test_run_mypy_symlinks.py
@@ -0,0 +1,63 @@
+"""run_mypy symlink handling (issue #7328)."""
+
+from __future__ import annotations
+
+import os
+from pathlib import Path
+from unittest.mock import patch
+
+import pytest
+
+from scripts.validation import git_hook_policy
+from scripts.validation.git_hook_policy import run_mypy
+
+pytestmark = pytest.mark.skipif(os.name != "posix", reason="symlinks need POSIX")
+
+
+def _stub(monkeypatch: pytest.MonkeyPatch) -> list[list[str]]:
+    seen: list[list[str]] = []
+
+    def fake_filter(paths: list[str], root: Path, base: str) -> list[str]:
+        seen.append(list(paths))
+        return []
+
+    monkeypatch.setattr(git_hook_policy, "_filter_to_merge_base_scope", fake_filter)
+    monkeypatch.setattr(git_hook_policy, "_mypy_ratchet_base_ref", lambda: "HEAD")
+    return seen
+
+
+def test_link_to_in_repo_file_is_swapped_for_target(
+    tmp_path: Path, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    (tmp_path / "src").mkdir()
+    (tmp_path / ".claude").mkdir()
+    (tmp_path / "src" / "mod.py").write_text("X = 1\n", encoding="utf-8")
+    (tmp_path / ".claude" / "mod.py").symlink_to("../src/mod.py")
+    seen = _stub(monkeypatch)
+    assert run_mypy([".claude/mod.py"], tmp_path) == 0
+    assert seen == [["src/mod.py"]]
+
+
+def test_link_and_target_both_listed_checked_once(
+    tmp_path: Path, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    (tmp_path / "src").mkdir()
+    (tmp_path / ".claude").mkdir()
+    (tmp_path / "src" / "mod.py").write_text("X = 1\n", encoding="utf-8")
+    (tmp_path / ".claude" / "mod.py").symlink_to("../src/mod.py")
+    seen = _stub(monkeypatch)
+    run_mypy(["src/mod.py", ".claude/mod.py"], tmp_path)
+    assert seen == [["src/mod.py"]]
+
+
+def test_link_escaping_repo_is_refused(
+    tmp_path: Path, capsys: pytest.CaptureFixture[str]
+) -> None:
+    repo = tmp_path / "repo"
+    repo.mkdir()
+    outside = tmp_path / "outside.py"
+    outside.write_text("X = 1\n", encoding="utf-8")
+    (repo / "link.py").symlink_to(outside)
+    with patch.object(git_hook_policy, "_mypy_ratchet_base_ref", return_value="HEAD"):
+        assert run_mypy(["link.py"], repo) == 2
+    assert "refusing to type-check symlink" in capsys.readouterr().err
