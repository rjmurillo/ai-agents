diff --git a/scripts/validation/git_hook_policy.py b/scripts/validation/git_hook_policy.py
index 434ea62..244801a 100644
--- a/scripts/validation/git_hook_policy.py
+++ b/scripts/validation/git_hook_policy.py
@@ -3743,9 +3743,17 @@ def run_mypy(paths: Sequence[str], repo_root: Path) -> int:
         if not full_path.is_file():
             continue
         if full_path.is_symlink():
-            print(f"ERROR: refusing to type-check symlink: {path}", file=sys.stderr)
-            return 2
-        checked_paths.append(path)
+            # A link is accepted only when it resolves to a regular file inside
+            # the repository; it is then type-checked as its target. Links that
+            # escape the repo, dangle, or point at non-files stay refused.
+            resolved_root = repo_root.resolve()
+            target = full_path.resolve()
+            if not target.is_file() or not target.is_relative_to(resolved_root):
+                print(f"ERROR: refusing to type-check symlink: {path}", file=sys.stderr)
+                return 2
+            path = target.relative_to(resolved_root).as_posix()
+        if path not in checked_paths:
+            checked_paths.append(path)
     checked_paths = [
         path for path in checked_paths if not _is_verbatim_mirror_on_disk(repo_root, path)
     ]
diff --git a/tests/validation/test_issue_7328_repro.py b/tests/validation/test_issue_7328_repro.py
index 144d69a..a98e7a3 100644
--- a/tests/validation/test_issue_7328_repro.py
+++ b/tests/validation/test_issue_7328_repro.py
@@ -42,3 +42,33 @@ def test_run_mypy_does_not_refuse_a_link_to_an_in_repo_python_file(
         code = run_mypy([".claude/lib/mod.py"], tmp_path)
     assert "refusing to type-check symlink" not in capsys.readouterr().err
     assert code != 2
+
+
+def test_run_mypy_still_refuses_a_link_outside_the_repo(
+    tmp_path: Path, capsys: pytest.CaptureFixture[str]
+) -> None:
+    repo = tmp_path / "repo"
+    repo.mkdir()
+    outside = tmp_path / "outside.py"
+    outside.write_text("X = 1\n", encoding="utf-8")
+    (repo / "link.py").symlink_to(outside)
+    assert run_mypy(["link.py"], repo) == 2
+    assert "refusing to type-check symlink" in capsys.readouterr().err
+
+
+def test_run_mypy_dedupes_a_link_and_its_target(tmp_path: Path) -> None:
+    (tmp_path / "src").mkdir()
+    (tmp_path / "src" / "mod.py").write_text("X = 1\n", encoding="utf-8")
+    (tmp_path / "link.py").symlink_to("src/mod.py")
+    seen: list[list[str]] = []
+
+    def fake_filter(paths: list[str], *_args: object) -> list[str]:
+        seen.append(list(paths))
+        return []
+
+    with (
+        patch.object(git_hook_policy, "_mypy_ratchet_base_ref", return_value="HEAD"),
+        patch.object(git_hook_policy, "_filter_to_merge_base_scope", fake_filter),
+    ):
+        assert run_mypy(["link.py", "src/mod.py"], tmp_path) == 0
+    assert seen == [["src/mod.py"]]
