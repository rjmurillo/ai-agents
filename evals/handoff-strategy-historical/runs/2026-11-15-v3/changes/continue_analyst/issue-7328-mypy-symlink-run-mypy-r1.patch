diff --git a/scripts/validation/git_hook_policy.py b/scripts/validation/git_hook_policy.py
index 434ea62..c96b821 100644
--- a/scripts/validation/git_hook_policy.py
+++ b/scripts/validation/git_hook_policy.py
@@ -3743,9 +3743,21 @@ def run_mypy(paths: Sequence[str], repo_root: Path) -> int:
         if not full_path.is_file():
             continue
         if full_path.is_symlink():
-            print(f"ERROR: refusing to type-check symlink: {path}", file=sys.stderr)
-            return 2
-        checked_paths.append(path)
+            # A link to a regular file inside the repo is replaced by its
+            # target (binplace creates these under .claude/lib/). Anything
+            # else (outside the repo, non-file) is still refused.
+            target = full_path.resolve()
+            try:
+                target_rel = target.relative_to(repo_root.resolve()).as_posix()
+            except ValueError:
+                target_rel = None
+            safe_target = _safe_relative_path(target_rel) if target_rel else None
+            if safe_target is None or not target.is_file():
+                print(f"ERROR: refusing to type-check symlink: {path}", file=sys.stderr)
+                return 2
+            path = safe_target
+        if path not in checked_paths:
+            checked_paths.append(path)
     checked_paths = [
         path for path in checked_paths if not _is_verbatim_mirror_on_disk(repo_root, path)
     ]
