diff --git a/scripts/validation/git_hook_policy.py b/scripts/validation/git_hook_policy.py
index 434ea62..1a1804f 100644
--- a/scripts/validation/git_hook_policy.py
+++ b/scripts/validation/git_hook_policy.py
@@ -3743,8 +3743,17 @@ def run_mypy(paths: Sequence[str], repo_root: Path) -> int:
         if not full_path.is_file():
             continue
         if full_path.is_symlink():
-            print(f"ERROR: refusing to type-check symlink: {path}", file=sys.stderr)
-            return 2
+            # A link to a regular file inside the repo (binplace's .claude/lib
+            # entries) is checked through its target, which is in the same diff.
+            # Links that leave the repo, or do not resolve to a file, stay refused.
+            root = repo_root.resolve()
+            target = full_path.resolve()
+            if not (target.is_file() and target.is_relative_to(root)):
+                print(f"ERROR: refusing to type-check symlink: {path}", file=sys.stderr)
+                return 2
+            path = target.relative_to(root).as_posix()
+        if path in checked_paths:
+            continue
         checked_paths.append(path)
     checked_paths = [
         path for path in checked_paths if not _is_verbatim_mirror_on_disk(repo_root, path)
