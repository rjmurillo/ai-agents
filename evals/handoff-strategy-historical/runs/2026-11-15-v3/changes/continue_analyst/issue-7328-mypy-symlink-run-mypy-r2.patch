--- a/tests/validation/test_issue_7328_repro.py
+++ b/tests/validation/test_issue_7328_repro.py
@@ -42,3 +42,21 @@ def test_run_mypy_does_not_refuse_a_link_to_an_in_repo_python_file(
         code = run_mypy([".claude/lib/mod.py"], tmp_path)
     assert "refusing to type-check symlink" not in capsys.readouterr().err
     assert code != 2
+
+
+def test_run_mypy_still_refuses_link_escaping_repo(
+    tmp_path: Path, capsys: pytest.CaptureFixture[str]
+) -> None:
+    repo = tmp_path / "repo"
+    (repo / ".claude" / "lib").mkdir(parents=True)
+    outside = tmp_path / "outside.py"
+    outside.write_text("X = 1\n", encoding="utf-8")
+    (repo / ".claude" / "lib" / "mod.py").symlink_to(outside)
+    assert run_mypy([".claude/lib/mod.py"], repo) == 2
+    assert "refusing to type-check symlink" in capsys.readouterr().err
+
+
+def test_run_mypy_dangling_link_is_skipped(tmp_path: Path) -> None:
+    (tmp_path / ".claude" / "lib").mkdir(parents=True)
+    (tmp_path / ".claude" / "lib" / "mod.py").symlink_to("../../missing.py")
+    assert run_mypy([".claude/lib/mod.py"], tmp_path) == 0
