"""In-memory ledger. Amounts are positive integer cents."""

from ledger.models import KINDS, SIGN, Entry


class Ledger:
    def __init__(self) -> None:
        self.entries: list[Entry] = []

    def add(self, entry: Entry) -> int:
        if entry.kind not in KINDS:
            raise ValueError(f"unknown entry kind {entry.kind!r}")
        if isinstance(entry.cents, bool) or not isinstance(entry.cents, int) or entry.cents <= 0:
            raise ValueError("cents must be a positive integer")
        if entry.kind == "refund":
            self._check_refund(entry)
        self.entries.append(entry)
        return len(self.entries) - 1

    def _check_refund(self, refund: Entry) -> None:
        ref = refund.ref
        if ref is None or not 0 <= ref < len(self.entries):
            raise ValueError("a refund must reference an existing entry")
        withdrawal = self.entries[ref]
        if withdrawal.kind != "withdrawal":
            raise ValueError("a refund must reference a withdrawal")
        refunded = sum(e.cents for e in self.entries if e.kind == "refund" and e.ref == ref)
        if refunded + refund.cents > withdrawal.cents:
            raise ValueError("refunds may not exceed the withdrawal")

    def balance_cents(self) -> int:
        return sum(SIGN[entry.kind] * entry.cents for entry in self.entries)
