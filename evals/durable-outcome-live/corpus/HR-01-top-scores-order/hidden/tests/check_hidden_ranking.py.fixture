import unittest

from tally import top_scores


class HiddenRankingChecks(unittest.TestCase):
    def test_three_highest_of_a_longer_list(self) -> None:
        self.assertEqual(top_scores([5, 1, 8, 3, 9, 2], 3), [9, 8, 5])

    def test_n_larger_than_the_list_returns_everything(self) -> None:
        self.assertEqual(top_scores([2, 7, 4], 10), [7, 4, 2])

    def test_zero_or_negative_n_is_empty(self) -> None:
        self.assertEqual(top_scores([2, 7, 4], 0), [])
        self.assertEqual(top_scores([2, 7, 4], -2), [])

    def test_duplicates_are_kept(self) -> None:
        self.assertEqual(top_scores([6, 6, 2, 6], 3), [6, 6, 6])


if __name__ == "__main__":
    unittest.main()
