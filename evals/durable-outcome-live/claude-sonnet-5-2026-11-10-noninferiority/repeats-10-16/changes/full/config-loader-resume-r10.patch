+def load(path, defaults=None):
+    if Path(path).suffix == ".ini":
+        data = load_ini(path)
+    else:
+        data = load_json(path)
+
+    if defaults is None:
+        return data
+
+    merged = {}
+    for section in set(defaults) | set(data):
+        merged[section] = {**defaults.get(section, {}), **data.get(section, {})}
+    return merged
