# Generated index files
.codebase-index.json
.codebase-intelligence.json

# Build artifacts
artifacts/
coverage.xml
.coverage
testResults.xml

# Transient eval artifacts (ADR-057): re-runnable, not source of truth
.agents/audit/eval-*/

# Model sweep run artifacts: runtime evidence under a tracked fixture tree.
evals/*/reports/sweep-*/
evals/*/runs/sweep-*/

# Transient PR-creation validation-skip audit logs: one record per
# `new_pr.py --skip-validation` invocation; reproducible from git
# history + hook output, not source of truth.
.agents/audit/pr-creation-skip-*.txt

# Runtime caches
.cache/

# Doc-accuracy gate output (transient per-target scratch dirs left
# behind by .claude/skills/doc-accuracy; reproducible from `--target`
# at run time, not source of truth).
.doc-accuracy/
**/.doc-accuracy/

# Claude memory backups (auto-generated by claude-mem plugin; not
# source of truth, regenerable from session logs).
.claude-mem/backups/*.json

# SARIF security-scan outputs (CodeQL, semgrep, etc.). always tool
# output, never authored.
*.sarif

# Python (ADR-042)
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
.venv/
venv/
ENV/
.mypy_cache/
.pytest_cache/
.pytest_tmp/
.ruff_cache/
# Legacy python build/dist outputs live at /build and /dist, anchored to repo
# root. An unanchored `build/` rule silently shadowed
# `src/copilot-cli/skills/build/` (the M4 generated `/build` slash-command
# skill), which made local file-counts diverge from CI.
/dist/
# The generator SOURCE tree (build/scripts, build/*.py, build/*.md) also lives
# under build/. A blanket `/build/` would re-hide a NEW source file (git does not
# descend into an excluded directory, so `!build/scripts/` cannot rescue it),
# forcing `git add -f`. So do NOT exclude the build/ tree; ignore only the real
# OUTPUT subdirs. New files under build/ track by default.
/build/dist/
/build/build/
/build/lib/
/build/lib.*/
/build/temp/
/build/temp.*/
/build/bdist.*/
/build/audit/
**/__pycache__/

# Agent PR scratch files
.agents/pr-comments/
.agents/scratch/
.agents/temp/
.agents/logs/
.agents/.hook-state/

# Transient PR review reply drafts. The pr-comment-responder skill
# stages reply bodies as files for `--body-file` posting; once the
# reply is on the PR thread the local copy has no enduring value.
# Reply drafts must not accumulate as untracked workspace clutter.
.agents/audit/pr-*-replies/
.agents/audit/pr*-reply-*.md
.agents/audit/pr*-reply.md
.agents/audit/pr*-body-*.md

# scripts/ci/build_pr_validation_report.py writes this to the repo root.
# Harmless on an ephemeral runner, untracked litter in a working tree.
# tests/ci/test_workflow_artifacts_are_ignored.py keeps this list complete;
# every rule stays anchored so it cannot hide a same-named file elsewhere.
/pr-validation-report.md
/metrics-report.txt
/metrics.json
/hook-bypass-count.txt
/comment-body.md
/comment.md
/drift-count.txt
/drift-details.md
/drift-results.json
/issue-body.md
/homework-results.json
/health-report.json
/health-report.md
/memory-health-report.md
/memory-validation-results.json
/quality-grades.json
/quality-grades.md

# Hook runtime logs and caches
.claude/hooks/audit.log

# Skill-pattern loader cache. Maps absolute source paths to float mtimes, so
# every contributor's copy differs on every line. Matched under any hook event
# directory, not just Stop/, so a second writer does not reopen the hole.
.claude/hooks/**/.skill_pattern_cache.json

# Scheduled-task runtime lock (held while ScheduleWakeup-managed loops run)
.claude/scheduled_tasks.lock

# Advisory lock files left by portability baseline writes (issue #4511).
# The lock file must persist between runs to avoid inode-replacement races,
# so deleting it after each run is unsafe. Ignoring it keeps git status clean.
scripts/validation/.skill_md_portability_baseline.json.write-lock
scripts/validation/.skill_md_exec_portability_baseline.json.write-lock
scripts/validation/.skill_portability_baseline.json.write-lock

# IDE settings
.idea/
*.DotSettings.user

# Obsidian workspace (user-specific state)
**/.obsidian/workspace.json
**/.obsidian/workspace-mobile.json

# Git worktrees (isolated development branches)
.work-*/
worktree-*/
worktree--/
wt_*/
.wt/

# Flowbaby files
.flowbaby/

# Local environment configuration
.env*

# Factory.ai (DROID)
# Contents rather than the directory itself: .factory/mcp.json is tracked and
# generated from .mcp.json by sync_mcp_config.py, and the stage-mcp-config
# lefthook job stages it by explicit path. git refuses to add an explicit path
# under an ignored directory, and gitignore cannot re-include a file whose
# parent directory is excluded, so ".factory/" made that job fail on every
# .mcp.json edit. Excluding the contents leaves the negation below effective.
.factory/*
!.factory/mcp.json
# Claude hook runtime state
/.agents/.hook-state/

# CodeQL artifacts
.codeql/cli/
.codeql/db/
.codeql/results/
.codeql/logs/

# Traceability cache
.agents/.cache/

.claude/worktrees/
.worktrees/

# doc-accuracy gate output (skill produces large reports under .doc-accuracy/)
.doc-accuracy/

# Node / Bun (packages/)
node_modules/
bun.lockb
*.tgz

# Kill-criteria telemetry (REQ-008-09): runtime events are not source of
# truth and must not land in git. Only the .gitkeep seed is tracked so the
# directory exists on a fresh clone.
.agents/metrics/drift-events.jsonl

# Model-sweep output (#3597). eval-model-sweep.py roots its artifacts at
# REPO_ROOT, so every run drops directories and an aggregate report inside the
# tracked evals/ tree where `git add evals` would commit them. Runtime evidence
# is regenerable and is not source of truth. Scoped to the `sweep-` run-id
# prefix that make_run_id guarantees, so tracked fixtures stay visible.
evals/*/reports/sweep-*
evals/*/runs/sweep-*

# Unexpanded tilde artifacts (#4295). A tool that joins "~" as a literal path
# segment instead of expanding it creates a real directory named `~` in its
# working directory rather than writing to $HOME. #1186 committed one that way.
# The result reads like a home directory path in `git ls-files`, which is the
# misreading that caused it.
#
# Root anchored on purpose. This catches the known recurrence at the repository
# root and does not catch a `~` directory deeper in the tree, so a legitimately
# named file there stays tracked. A tool invoked from a subdirectory still
# produces an unignored `docs/~/...`; that hole is real and is not closed here.
/~/
