{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "rebaseWhen": "behind-base-branch",
  "dependencyDashboard": false,
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "before 4am on monday"
    ],
    "automerge": true
  },
  "vulnerabilityAlerts": {
    "enabled": true,
    "minimumReleaseAge": null,
    "labels": [
      "security"
    ],
    "automerge": true
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github\\/workflows\\/plugin-cli-smoke\\.yml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n\\s+[A-Z_]+_VERSION: '(?<currentValue>[^']+)'"
      ]
    }
  ],
  "packageRules": [
    {
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "automerge": true,
      "minimumReleaseAge": "7 days"
    },
    {
      "matchManagers": [
        "devcontainer"
      ],
      "description": "A feature or image bump must refresh devcontainer-lock.json in the same PR. Automerge would land the bump alone and leave the lock stale, so these updates stay reviewable.",
      "automerge": false
    },
    {
      "matchUpdateTypes": [
        "major"
      ],
      "addLabels": [
        "renovate-major"
      ]
    },
    {
      "matchPackageNames": [
        "@anthropic-ai/claude-code",
        "@github/copilot",
        "@openai/codex",
        "@earendil-works/pi-coding-agent"
      ],
      "matchUpdateTypes": [
        "major",
        "minor",
        "patch"
      ],
      "automerge": true,
      "minimumReleaseAge": "7 days"
    }
  ],
  "platformAutomerge": true,
  "automerge": true
}
