{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "rebaseWhen": "behind-base-branch",
  "dependencyDashboard": false,
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "before 4am on monday"
    ],
    "automerge": true
  },
  "vulnerabilityAlerts": {
    "enabled": true,
    "minimumReleaseAge": null,
    "labels": [
      "security"
    ],
    "automerge": true
  },
  "packageRules": [
    {
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "automerge": true,
      "minimumReleaseAge": "7 days"
    },
    {
      "matchUpdateTypes": [
        "major"
      ],
      "addLabels": [
        "renovate-major"
      ]
    },
    {
      "matchPackageNames": [
        "@anthropic-ai/claude-code",
        "@github/copilot",
        "@openai/codex",
        "@earendil-works/pi-coding-agent"
      ],
      "matchUpdateTypes": [
        "major",
        "minor",
        "patch"
      ],
      "automerge": true,
      "minimumReleaseAge": "7 days"
    },
    {
      "matchFileNames": [
        ".github/workflows/**"
      ],
      "description": "A workflow file can hold secrets or write tokens, so a bump to it needs a human approval (#6506 review-gates-15). The scope is the workflow directory only. Renovate applies rules in order, so this rule sits after every rule that enables automerge.",
      "automerge": false
    },
    {
      "matchManagers": [
        "devcontainer"
      ],
      "description": "A feature or image bump must refresh devcontainer-lock.json in the same PR. Automerge would land the bump alone and leave the lock stale, so these updates stay reviewable. This rule sits last on purpose: Renovate applies rules in order, and no rule after it may re-enable automerge.",
      "automerge": false
    }
  ],
  "platformAutomerge": true,
  "automerge": true
}
