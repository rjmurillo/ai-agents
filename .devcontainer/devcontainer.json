{
  "name": "ai-agents",
  "image": "mcr.microsoft.com/devcontainers/python:2-3.14-trixie@sha256:43311767f101e1c2a7bd0ecacf2c866f5c42124fc2efe45bb384eb2995ecce4d",
  "features": {
    "ghcr.io/devcontainers/features/node:2.1.1": {
      // CI uses lts/*, which resolves to 26 today. A fixed major keeps
      // rebuilds stable; bump it when CI's LTS line moves.
      "version": "26",
      "pnpmVersion": "none"
    },
    "ghcr.io/devcontainers/features/powershell:2.0.3": {
      "version": "7.5"
    },
    "ghcr.io/devcontainers/features/github-cli:1.1.3": {
      "version": "2.103.3"
    },
    "ghcr.io/va-h/devcontainers-features/uv:1.1.4": {
      "version": "0.13.6"
    }
  },
  "containerEnv": {
    // ADR-104 rule 8: tests/hooks/test_managed_image_marker.py requires every
    // tracked image to declare itself so hook timeouts clamp to the container.
    "AI_AGENTS_REMOTE_CONTAINER": "1",
    // The uv cache and the bind-mounted workspace sit on different
    // filesystems, so hardlinking fails and uv warns on every sync.
    "UV_LINK_MODE": "copy"
  },
  "postCreateCommand": "uv sync --frozen --extra dev && uv run --frozen lefthook install --reset-hooks-path && uv run --frozen lefthook check-install",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "charliermarsh.ruff",
        "ms-python.mypy-type-checker",
        "ms-vscode.powershell",
        "DavidAnson.vscode-markdownlint",
        "redhat.vscode-yaml",
        "github.vscode-github-actions"
      ]
    }
  }
}
